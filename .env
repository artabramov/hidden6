# NOTE (ADR-03): Environment variables are provided in a dotenv file.
# On first startup, the .env file is copied into the container.
# The entrypoint script then loads the environment variables before
# the application starts. Since the variables contain only non-secret
# values, a ready-to-use .env file is distributed instead
# of the .env.example template.

# Directory containing the application source code and runtime scripts.
INSTALL_SOURCE_CODE=/opt/hidden

# Directory containing the encrypted gocryptfs filesystem.
INSTALL_CIPHERDIR=/var/lib/cipherdir

# Directory used as the gocryptfs mount point.
INSTALL_MOUNTPOINT=/var/lib/mountpoint

# Directory containing the gocryptfs passphrase
# and internal secrets inside the container.
INSTALL_SECRETS=/var/lib/secrets

# Host path to the removable secrets volume.
# Must already exist before running make install.
# Bypass with: make install FORCE=1
VOLUME_SECRETS=/mnt/hidden-secrets

# Network address where the Uvicorn HTTP server binds.
# 0.0.0.0 allows connections from any interface.
UVICORN_HOST=0.0.0.0

# TCP port where the Uvicorn HTTP server listens.
UVICORN_PORT=80

# Interval (in seconds) between consecutive watchdog runs.
# The watchdog checks mount liveness and triggers an emergency unmount
# when the passphrase, secrets dir, or application process are missing.
# Must be less than WATCHDOG_LIVENESS_SECONDS.
WATCHDOG_INTERVAL_SECONDS=60

# Liveness threshold (in seconds) based on the last watchdog heartbeat.
# Watchdog is considered alive if the heartbeat file mtime is within
# this window. Must be greater than WATCHDOG_INTERVAL_SECONDS to avoid
# false negatives when polling health.
WATCHDOG_LIVENESS_SECONDS=120

# URL prefix applied to all API routes.
# Used for API versioning.
API_PREFIX=/api/v1

# Logging severity threshold for the application.
# Values: DEBUG, INFO, WARNING, ERROR, CRITICAL.
LOG_LEVEL=INFO

# Log message format used by the Python logging system.
LOG_FORMAT="%(asctime)s %(levelname)s %(name)s:%(lineno)d request_uuid=%(request_uuid)s %(message)s"

# Comma-separated list of allowed CORS origins.
# Matching origins receive Access-Control-Allow-Origin headers.
CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Browser cache lifetime (in seconds) for CORS preflight (OPTIONS)
# responses. Defaults to 24 hours. Set to 0 to disable preflight caching.
CORS_MAX_AGE_SECONDS=86400

# SQLite journaling mode used by the database engine.
# Must be DELETE on a FUSE filesystem (WAL is incompatible with gocryptfs).
SQLITE_JOURNAL_MODE=DELETE

# SQLite synchronization level controlling write durability.
# Must be FULL on a FUSE filesystem (NORMAL skips fsync, leaving
# writes buffered in the FUSE layer).
SQLITE_SYNCHRONOUS=FULL

# Maximum time in milliseconds SQLite waits on database locks.
# Helps avoid transient "database is locked" errors.
SQLITE_BUSY_TIMEOUT=5000

# Location used for SQLite temporary tables and indices.
# MEMORY stores temporary data in RAM for better performance.
SQLITE_TEMP_STORE=MEMORY

# SQLite database filename.
SQLITE_FILENAME=hidden.db

# AWS SigV4 credential scope region accepted during authentication.
S3_REGION=us-east-1

# AWS SigV4 credential scope service name (normally "s3").
S3_SERVICE=s3

# Maximum allowed clock skew in seconds for SigV4 timestamps
# (X-Amz-Date / Date). Requests outside this window receive 403.
S3_SIGV4_MAX_SKEW_SECONDS=900

# Maximum object size in bytes accepted by a single upload request.
# Larger bodies are rejected with an error before anything is written.
# Defaults to 5 GiB, the AWS S3 single-request limit.
S3_UPLOAD_MAX_BYTES=5368709120

# Comma-separated list of extensions to load. Empty means no extensions.
EXTENSIONS_ENABLED=example_extension


# aws configure set aws_access_key_id Y3NkmQOytFk7gjS7DXnL
# aws configure set aws_secret_access_key UGmbGaa2gn7vgvd83279YGV49kNAxvPXMVkFeBKK
# aws configure set default.region us-east-1

# create bucket:
# aws s3 mb s3://my-bucket --endpoint-url http://localhost:80

# list buckets:
# aws s3 ls --endpoint-url http://localhost:80

# upload file:
# aws s3 cp ./Screenshot_100.png s3://my-bucket/photos/2026/Screenshot_100.png --endpoint-url http://localhost:80

# object list:
# aws s3 ls s3://my-bucket/photos/ --endpoint-url http://localhost:80

# download file:
# aws s3 cp s3://my-bucket/photos/2026/Screenshot_100.png ./downloaded.png --endpoint-url http://localhost:80

# get bucket versioning
# aws s3api get-bucket-versioning --bucket my-bucket --endpoint-url http://localhost:80




