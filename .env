# NOTE (ADR-04): Environment variables are distributed in a dotenv file.
# On first startup, the .env file is copied into the container.
# The entrypoint script then loads the environment variables before
# the application starts. Since the variables contain only non-secret
# values, a ready-to-use .env file is distributed instead
# of the .env.example template.

# Directory containing the application source code and runtime scripts.
INSTALL_SOURCE_CODE=/opt/hidden

# Directory containing the encrypted gocryptfs filesystem.
INSTALL_CIPHERDIR=/var/lib/cipherdir

# Directory used as the gocryptfs mount point.
INSTALL_MOUNTPOINT=/var/lib/mountpoint

# Directory containing the gocryptfs passphrase
# and internal secrets inside the container.
INSTALL_SECRETS=/var/lib/secrets

# Host path to the removable secrets volume.
# Must already exist before running make install.
# Bypass with: make install FORCE=1
VOLUME_SECRETS=/mnt/hidden-secrets

# Network address where the Uvicorn HTTP server binds.
# 0.0.0.0 allows connections from any interface.
UVICORN_HOST=0.0.0.0

# TCP port where the Uvicorn HTTP server listens.
UVICORN_PORT=80

# URL prefix applied to all API routes.
# Used for API versioning.
API_PREFIX=/api/v1
